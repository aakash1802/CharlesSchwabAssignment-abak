# Copy to .env and fill values. Never commit .env.

AGENTIC_LOG_LEVEL=INFO

# Providers: mock (default, offline) | anthropic (live)
AGENTIC_LLM_PROVIDER=mock

# For anthropic:
# AGENTIC_LLM_PROVIDER=anthropic
# AGENTIC_LLM_MODEL=claude-sonnet-4-5
# AGENTIC_LLM_API_KEY=sk-ant-...
# Or use the standard Anthropic env var instead of AGENTIC_LLM_API_KEY:
# ANTHROPIC_API_KEY=sk-ant-...

# AGENTIC_LLM_TIMEOUT_SECONDS=60
# AGENTIC_LLM_MAX_TOKENS=4096
# AGENTIC_MAX_TASK_RETRIES=2
